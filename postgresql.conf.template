# ========================================
# Auto-generated by tunner.sh - DO NOT EDIT.
# Regenerate: ./tunner.sh   (override: --ram MB --cpu N --disk ssd|hdd)
# Source of truth: postgresql.conf.template
# ========================================

# MEMORY SETTINGS
shared_buffers = @SHARED_BUFFERS@MB                # ~25% of RAM (buffer cache)
effective_cache_size = @EFFECTIVE_CACHE_SIZE@MB    # ~75% of RAM (planner cache estimate)
work_mem = @WORK_MEM@MB                            # per sort/hash operation
maintenance_work_mem = @MAINTENANCE_WORK_MEM@MB    # VACUUM / CREATE INDEX

# CONNECTION SETTINGS
max_connections = @MAX_CONNECTIONS@                              # headroom above PgBouncer's max_db_connections
listen_addresses = '*'
port = 5432

# CPU OPTIMIZATION
max_worker_processes = @MAX_WORKER_PROCESSES@      # cores + headroom (autovacuum + parallel share this pool)
max_parallel_workers = @MAX_PARALLEL_WORKERS@
max_parallel_workers_per_gather = @MAX_PARALLEL_WORKERS_PER_GATHER@
max_parallel_maintenance_workers = @MAX_PARALLEL_MAINTENANCE_WORKERS@

# STORAGE OPTIMIZATION  (@DISK_TYPE@)
random_page_cost = @RANDOM_PAGE_COST@
effective_io_concurrency = @EFFECTIVE_IO_CONCURRENCY@

# WRITE PERFORMANCE (WAL)
wal_buffers = @WAL_BUFFERS@MB
checkpoint_completion_target = 0.9
max_wal_size = 1GB
min_wal_size = 256MB

# LOGGING
logging_collector = off                            # logs go to stderr -> docker json-file
log_min_duration_statement = 1000                  # log queries slower than 1s
log_parameter_max_length = 0                       # never log bind-parameter VALUES (slow-query logs keep $n placeholders)
log_checkpoints = on
log_connections = on
log_disconnections = off

# PERFORMANCE MONITORING
shared_preload_libraries = 'pg_stat_statements'   # also run: CREATE EXTENSION pg_stat_statements;
track_activities = on
track_counts = on
track_io_timing = on

# AUTOVACUUM
autovacuum = on
autovacuum_max_workers = 2
autovacuum_naptime = 30s
autovacuum_vacuum_threshold = 50
autovacuum_analyze_threshold = 50
