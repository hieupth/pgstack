# Auto-generated by tunner.sh - DO NOT EDIT.
# Regenerate: ./tunner.sh
# Source of truth: pgbouncer.ini.template
# Note: default_pool_size / pool_size / max_db_connections are hardware-derived
#       STARTING POINTS (tunner.sh). Tune them after measuring real load (README).

[databases]
# Universal wildcard - automatically handles ANY database
* = host=postgresql port=5432 pool_size=@DEFAULT_POOL_SIZE@

[pgbouncer]
# Connection settings
listen_addr = 0.0.0.0
listen_port = 5432

# Authentication: static auth_file with SCRAM verifiers ONLY - no plaintext
# anywhere on disk. Managed by ./cred.sh, which copies each verifier
# byte-identical from pg_shadow (REQUIRED for SCRAM pass-through to the
# backend: same salt+iterations, not merely the same password).
# auth_type=scram-sha-256 makes every client authenticate via SCRAM, which
# enables that pass-through. NB: legacy non-SCRAM clients cannot connect.
auth_type = scram-sha-256
auth_file = /run/secrets/pgbouncer_userlist

# Pool settings - transaction pooling scales many clients onto few backends
pool_mode = transaction
# Required for clients that use named prepared statements (e.g. ZITADEL's pgx
# driver). PgBouncer 1.21+ tracks/multiplexes them across pooled server conns.
# Without this, transaction pooling breaks such clients with
# "prepared statement ... already exists". 0 = disabled.
max_prepared_statements = 256
max_client_conn = 2000
default_pool_size = @DEFAULT_POOL_SIZE@
min_pool_size = 8
reserve_pool_size = 12
max_db_connections = @MAX_DB_CONNECTIONS@
max_user_connections = 100

# Behavior settings
server_round_robin = 1
ignore_startup_parameters = extra_float_digits,application_name,options
server_check_delay = 30
server_check_query = SELECT 1
server_lifetime = 3600
server_idle_timeout = 600
client_login_timeout = 60
# (server_reset_query is intentionally omitted: it is a no-op in transaction pooling)

# Admin settings - dedicated console user, created/rotated by ./cred.sh pgbouncer_admin
# (random password, NOT the postgres superuser). Until that script has run
# once, the console is unreachable by design (fail-safe).
admin_users = pgbouncer_admin
stats_users = pgbouncer_admin
log_connections = 1
log_disconnections = 0
log_pooler_errors = 1
verbose = 0

# TLS: App -> PgBouncer (required)
client_tls_sslmode = require
client_tls_ca_file = /ssl/ca.pem
client_tls_cert_file = /ssl/cert.pem
client_tls_key_file = /ssl/privkey.pem

# TLS: PgBouncer -> PostgreSQL (disabled by default).
# To enable, set ssl=on in postgresql.conf + mount server certs, then set:
#   server_tls_sslmode = prefer
#   server_tls_ca_file = /ssl/ca.pem
server_tls_sslmode = disable
